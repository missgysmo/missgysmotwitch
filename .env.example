# Nom du channel Twitch (sans le #)
TWITCH_CHANNEL=missgysmo

# App Twitch créée sur https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# URL de redirection OAuth configurée sur l'app Twitch (doit correspondre exactement)
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback

# Port du serveur local
PORT=3000

# Mot de passe pour accéder à /settings (obligatoire, choisis-en un solide)
SETTINGS_PASSWORD=

# Optionnel : dossier où stocker data/*.json (avatars, réglages, tokens).
# Sur Railway, pointe vers le point de montage du volume persistant (ex: /data).
# En local, laisse vide pour utiliser ./data.
DATA_DIR=
